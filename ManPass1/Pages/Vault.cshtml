@page
@model ManPass1.Pages.VaultModel

@{
    ViewData["Title"] = "Vault";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Your Vault</h2>

        <p class="text-muted">Welcome, @User.Identity?.Name.
        </p>
        </div>
        <a asp-page="/AddCredential"
           class="btn btn-primary">
            Add Credential
        </a>
    </div>
    <form method="get" class="mb-4">

        <div class="input-group">

            <input asp-for="SearchTerm"
                   class="form-control"
                   placeholder="Search website or username..." />

            <button type="submit"
                    class="btn btn-outline-primary">
                Search
            </button>

            <a asp-page="/Vault"
               class="btn btn-outline-secondary">
                Clear
            </a>

        </div>

    </form>
    @if (Model.Credentials.Count == 0)
    {
        <div class="alert alert-secondary">
            You don't have any saved credentials yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var credential in Model.Credentials)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @credential.WebsiteName
                            </h5>

                            <p class="card-text mb-1">
                                <strong>Username:</strong>
                                @credential.Username
                            </p>

                            @if (!string.IsNullOrWhiteSpace(credential.WebsiteUrl))
                            {
                                <p class="card-text">

                                    <a href="@credential.WebsiteUrl"
                                       target="_blank">
                                        Visit Website
                                    </a>

                                </p>
                            }

                            <p class="card-text">
                                <strong>Password:</strong>
                                ••••••••••••
                            </p>

                            <div class="mt-3">

                                <a asp-page="/ViewCredential"
                                   asp-route-id="@credential.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <a asp-page="/EditCredential"
                                   asp-route-id="@credential.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <a asp-page="/DeleteCredential"
                                   asp-route-id="@credential.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
</div>