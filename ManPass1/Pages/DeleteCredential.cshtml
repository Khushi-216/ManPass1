@page
@model ManPass1.Pages.DeleteCredentialModel

@{
    ViewData["Title"] = "Delete Credential";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h3 class="mb-3">Delete Credential</h3>

                    <p>
                        Are you sure you want to delete:
                    </p>

                    <h5>@Model.Credential.WebsiteName</h5>

                    <p class="text-muted">
                        @Model.Credential.Username
                    </p>

                    <form method="post">

                        <input type="hidden" asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                        <a asp-page="/Vault"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>