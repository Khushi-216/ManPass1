@page
@model ManPass1.Pages.DeleteCredentialModel

@{
    ViewData["Title"] = "Delete Credential";
}

<section class="form-page">
    <div class="form-card danger-card">
        <div class="eyebrow">Delete Item</div>
        <h1>Remove this credential?</h1>
        <p class="form-intro">This will permanently remove the saved login from your vault.</p>

        <div class="delete-target">
            <strong>@Model.Credential.WebsiteName</strong>
            <span>@Model.Credential.Username</span>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="/Vault" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>
