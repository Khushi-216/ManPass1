@page
@model ManPass1.Pages.EditCredentialModel

@{
    ViewData["Title"] = "Edit Credential";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h2 class="mb-4">Edit Credential</h2>

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="WebsiteName" class="form-label"></label>
                    <input asp-for="WebsiteName" class="form-control" />
                    <span asp-validation-for="WebsiteName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WebsiteUrl" class="form-label"></label>
                    <input asp-for="WebsiteUrl" class="form-control" />
                    <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-page="/Vault" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}