@page
@model ManPass1.Pages.ViewCredentialModel

@{
    ViewData["Title"] = "View Credential";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h3 class="card-title mb-4">
                        @Model.Credential.WebsiteName
                    </h3>

                    <p>
                        <strong>Website URL:</strong><br />

                        @if (!string.IsNullOrWhiteSpace(Model.Credential.WebsiteUrl))
                        {
                            <a href="@Model.Credential.WebsiteUrl"
                               target="_blank">
                                @Model.Credential.WebsiteUrl
                            </a>
                        }
                        else
                        {
                            <span>Not provided</span>
                        }
                    </p>

                    <p>
                        <strong>Username:</strong><br />
                        @Model.Credential.Username
                    </p>

                    <p>
                        <strong>Password:</strong><br />
                        <span>@Model.DecryptedPassword</span>
                    </p>

                    <div class="mt-4">

                        <a asp-page="/EditCredential"
                           asp-route-id="@Model.Credential.Id"
                           class="btn btn-outline-secondary">
                            Edit
                        </a>

                        <a asp-page="/Vault"
                           class="btn btn-secondary">
                            Back to Vault
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>