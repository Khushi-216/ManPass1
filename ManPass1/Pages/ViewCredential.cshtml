@page
@model WeRemember.Pages.ViewCredentialModel

@{
    ViewData["Title"] = "View Credential";
}

<section class="form-page">
    <div class="form-card detail-card">
        <div class="vault-card-top">
            <span class="vault-logo">
                @Model.Credential.WebsiteName.Substring(0, 1).ToUpper()
            </span>
            <div>
                <div class="eyebrow">Credential</div>
                <h1>@Model.Credential.WebsiteName</h1>
            </div>
        </div>

        <dl class="detail-list">
            <div>
                <dt>Website URL</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Credential.WebsiteUrl))
                    {
                        <a href="@Model.Credential.WebsiteUrl" target="_blank">
                            @Model.Credential.WebsiteUrl
                        </a>
                    }
                    else
                    {
                        <span>Not provided</span>
                    }
                </dd>
            </div>

            <div>
                <dt>Username</dt>
                <dd>@Model.Credential.Username</dd>
            </div>

            <div>
                <dt>Password</dt>
                <dd class="revealed-password">@Model.DecryptedPassword</dd>
            </div>
        </dl>

        <div class="form-actions">
            <a asp-page="/EditCredential"
               asp-route-id="@Model.Credential.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-page="/Vault" class="btn btn-outline-secondary">
                Back to Vault
            </a>
        </div>
    </div>
</section>
